{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://otzaria.invalid/schemas/action-request-v1.json",
  "title": "Otzaria Semantic ActionRequest v1 (design contract)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "apiVersion",
    "requestId",
    "action",
    "arguments"
  ],
  "properties": {
    "apiVersion": {
      "const": 1
    },
    "requestId": {
      "type": "string",
      "format": "uuid"
    },
    "action": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(\\.[a-zA-Z0-9]+)+$",
      "maxLength": 80
    },
    "arguments": {
      "type": "object",
      "additionalProperties": true,
      "maxProperties": 30,
      "description": "Validated AGAINST selected ActionRegistry descriptor argsSchema; this envelope alone is not sufficient."
    },
    "expectedBackend": {
      "enum": [
        "otzaria",
        "sefaria",
        "sefariaEmbedded"
      ]
    },
    "expectedGeneration": {
      "type": "integer",
      "minimum": 0
    },
    "idempotencyKey": {
      "type": "string",
      "minLength": 16,
      "maxLength": 128
    },
    "requestedPresentation": {
      "enum": [
        "headless",
        "foreground"
      ]
    },
    "deadlineMs": {
      "type": "integer",
      "minimum": 100,
      "maximum": 60000
    }
  },
  "description": "Public untrusted request only; no origin, permission or caller-controlled auth fields. These are supplied out of band via trusted ExecutionContext."
}
