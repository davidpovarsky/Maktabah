    "convertImportHelpDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إذا كانت قاعدة بيانات SQLite الخاصة بك لا تتطابق مع التنسيق المطلوب لدينا، فاستخدم أداة Web Converter لتحويل ملفاتك. حاليا يتم دعم ملفات .docx و.epub فقط."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "If your SQLite database doesn't match our required format, use our Web Converter tool to transform your files. Currently only .docx and .epub files are supported."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Jika basis data SQLite Anda tidak sesuai dengan format yang kami butuhkan, gunakan alat Konverter Web kami untuk mengubah file Anda. Saat ini hanya file .docx dan .epub yang didukung."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אם מסד הנתונים SQLite שלך אינו תואם למבנה הנדרש, השתמש בכלי ההמרה באינטרנט כדי להמיר את הקבצים. כרגע נתמכים רק קובצי .docx ו-.epub."
          }
        }
      }
    },
