    "exactSearchDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يضمن أن جميع الكلمات المكتوبة موجودة بشكل متجاور وبالترتيب الصحيح في البيانات. (على سبيل المثال، عقيدة الإمام الشافعي)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ensures all typed words are found adjacently and in the exact order in the data. (e.g., عقيدة الإمام الشافعي)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fitur ini memastikan semua kata yang diketik ditemukan secara berurutan dan sesuai urutan aslinya di dalam data (contoh: عقيدة الإمام الشافعي)."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מוודא שכל המילים שהוקלדו נמצאות בצמידות ובאותו סדר בדיוק בנתונים. (לדוגמה: عقيدة الإمام الشافعي)"
          }
        }
      }
    },
