    "core.modal.message": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب التطبيق ملف قاعدة البيانات الرئيسي (~ 17,96 ميغابايت) الذي يتم تنزيله مرة واحدة عند فتحه لأول مرة. سيتم حفظ الملف في مجلد دعم التطبيقات."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Application requires the main database file (~17,96 MB) that is downloaded once when first opened. The file will be saved in the Application Support folder."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Maktabah memerlukan file database utama (~17,96 MB) yang diunduh sekali saat pertama kali dibuka. File akan disimpan di folder Application Support."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "האפליקציה דורשת את קובץ מסד הנתונים הראשי (~17.96 MB), שיורד פעם אחת בפתיחה הראשונה. הקובץ יישמר בתיקיית התמיכה של האפליקציה."
          }
        }
      }
    },
