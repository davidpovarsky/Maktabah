    ".ftsMigrationDesc": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تقدم هذه الترقية تقنية Light10 Stemming، مما يتيح لك البحث في النص العربي مع تجاهل السوابق واللواحق الشائعة."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This upgrade introduces Light10 Stemming, allowing you to search Arabic text by ignoring common prefixes and suffixes."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peningkatan ini menggunakan Light10 Arabic Stemming, memungkinkan pencarian dengan mengabaikan awalan dan akhiran umum."
          }
        }
      }
    },
    ".ftsMigrationExample": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مثال: البحث عن \"كتب\" سيجد أيضاً \"وكتب\"، \"فكتب\"، \"الكتب\"، إلخ."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Example: Searching for \"كتب\" will also find \"وكتب\", \"فكتب\", \"الكتب\", etc."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Contoh: Mencari \"كتب\" juga akan menemukan \"وكتب\", \"فكتب\", \"الكتب\", dll."
          }
        }
      }
    },
