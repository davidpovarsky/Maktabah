      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبحث عن الكلمات مفصولة بفاصلة (،) التي تظهر بالقرب بعضها من البعض ضمن الحد الأقصى لمسافة الكلمة المحددة في حقل العدد. (المثال: الإيمان، العمل)"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searches for words separated by a comma (,) that appear near each other within the maximum word distance set in the number field. (e.g., الإيمان, العمل)"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencari kata-kata yang dipisahkan oleh koma (,) yang muncul berdekatan satu sama lain dalam jarak kata maksimum yang ditetapkan di bidang angka. (contoh: الإيمان, العمل)"
