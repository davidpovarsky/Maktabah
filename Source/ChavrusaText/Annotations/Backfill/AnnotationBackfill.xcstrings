        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדיקה והמשך"
          }
        }
      }
    },
    "Convert saved notes to expanded editing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert saved notes to expanded editing"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המרת הערות שמורות לעריכה מורחבת"
          }
        }
      }
    },
    "Only saved notes are converted. Sharing with Anytype remains a separate choice. Existing rich notes and longer notes are kept unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only saved notes are converted. Sharing with Anytype remains a separate choice. Existing rich notes and longer notes are kept unchanged."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הערות שמורות יומרו. השיתוף עם Anytype יישאר פעולה נפרדת לבחירתך. הערות בפורמט עשיר והערות ארוכות יישמרו ללא שינוי."
          }
        }
      }
    },
    "%lld notes converted": {
      "extractionState": "manual",
      "localizations": {
