    "Prepare the existing notes above before starting conversion.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prepare the existing notes above before starting conversion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להכין תחילה את ההערות הקיימות באמצעות הפעולה שלמעלה."
          }
        }
      }
    },
    "Open preparation from the current study workspace to convert its notes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open preparation from the current study workspace to convert its notes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כדי להמיר את ההערות, יש לפתוח את מסך ההכנה מתוך סביבת הלימוד הנוכחית."
          }
        }
      }
    },
    "Convert these saved notes?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Convert these saved notes?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להמיר את ההערות השמורות?"
          }
        }
      }
    },
    "Cancel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cancel"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ביטול"
          }
        }
      }
    },
    "The original editor will preserve each complete saved note before saving its expanded format. Saved changes follow your existing iCloud settings. You can pause and continue; notes already converted will be kept.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The original editor will preserve each complete saved note before saving its expanded format. Saved changes follow your existing iCloud settings. You can pause and continue; notes already converted will be kept."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העורך המקורי ישמור את מלוא התוכן של כל הערה לפני שמירתה בפורמט המורחב. שינויים שמורים יסונכרנו בהתאם להגדרות iCloud הקיימות. אפשר להשהות ולהמשיך; הערות שכבר הומרו יישמרו."
          }
        }
      }
    },
    "Conversion scan complete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversion scan complete"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סריקת ההמרה הושלמה"
          }
        }
      }
    },
    "Conversion paused. Saved conversions are kept; continue to check the remaining notes.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversion paused. Saved conversions are kept; continue to check the remaining notes."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההמרה הושהתה. המרות שנשמרו נשארות במקומן; אפשר להמשיך כדי לבדוק את ההערות שנותרו."
          }
        }
      }
    },
    "Conversion stopped because a saved note or the original editor could not be verified. Saved conversions are kept; other notes remain unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversion stopped because a saved note or the original editor could not be verified. Saved conversions are kept; other notes remain unchanged."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההמרה נעצרה כי לא ניתן היה לאמת הערה שמורה או את העורך המקורי. המרות שנשמרו נשארות במקומן; שאר ההערות נשארות ללא שינוי."
          }
        }
      }
    },
    "The private editor has not finished closing. Close any other expanded editor, then retry closing here.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The private editor has not finished closing. Close any other expanded editor, then retry closing here."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגירת העורך הפרטי טרם הסתיימה. יש לסגור כל עורך מורחב אחר, ואז לנסות שוב את הסגירה כאן."
          }
        }
      }
    },
    "Closing the private editor…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Closing the private editor…"
          }
