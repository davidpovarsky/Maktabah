        }
      }
    },
    "The same note ID and complete original body were saved. Reopen the expanded editor to continue privately.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same note ID and complete original body were saved. Reopen the expanded editor to continue privately."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מזהה ההערה והתוכן המקורי המלא נשמרו. אפשר לפתוח שוב את העורך המורחב כדי להמשיך בעריכה פרטית."
          }
        }
      }
    },
    "No shared copy in this space": {
