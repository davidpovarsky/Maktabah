    },
    "The copy was read back with the requested change. Its source links and object ID were preserved. Visibility on another device is checked separately.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The copy was read back with the requested change. Its source links and object ID were preserved. Visibility on another device is checked separately."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העותק נקרא בחזרה עם השינוי המבוקש. קישורי המקורות והמזהה שלו נשמרו. הופעת השינוי במכשיר אחר נבדקת בנפרד."
          }
        }
      }
    },
    "The current content, archive status or type changed before this action. Nothing from this action was applied. Close and review the current copy again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
