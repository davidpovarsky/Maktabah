        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוכן, מצב הארכיון או סוג העותק השתנו לפני הפעולה. הפעולה לא החילה שינויים. יש לסגור ולבדוק שוב את העותק העדכני."
          }
        }
      }
