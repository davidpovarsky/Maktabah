{
  "sourceLanguage": "en",
  "strings": {
    "Anytype has not finished closing. Retry the original close operation before switching accounts.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anytype has not finished closing. Retry the original close operation before switching accounts."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Anytype טרם סיים להיסגר. יש לנסות שוב את פעולת הסגירה לפני מעבר בין חשבונות."
          }
        }
      }
    },
    "Anytype read back the complete note and its object mapping. Delivery to another device has not yet been verified.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anytype read back the complete note and its object mapping. Delivery to another device has not yet been verified."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Anytype קרא בחזרה את ההערה המלאה ואת מיפוי האובייקטים שלה. המסירה למכשיר אחר עדיין לא אומתה."
          }
        }
      }
    },
    "Checking the saved note…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the saved note…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק את ההערה השמורה…"
          }
        }
      }
    },
    "Close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגור"
          }
        }
      }
    },
    "Close the editor and reopen the note to check the saved version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the editor and reopen the note to check the saved version."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגור את העורך ופתח מחדש את ההערה כדי לבדוק את הגרסה השמורה."
          }
        }
      }
    },
    "Close this screen and check Anytype before trying again. A started transfer may already have created a copy; it will not be sent twice automatically.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close this screen and check Anytype before trying again. A started transfer may already have created a copy; it will not be sent twice automatically."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לסגור את המסך ולבדוק ב־Anytype לפני ניסיון נוסף. ייתכן שהעברה שכבר החלה יצרה עותק; ההערה לא תישלח שוב באופן אוטומטי."
          }
        }
      }
    },
    "Continue editing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue editing"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך בעריכה"
          }
        }
      }
    },
    "Copy verified in Anytype": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Copy verified in Anytype"
          }
        },
        "he": {
          "stringUnit": {
