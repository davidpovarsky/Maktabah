    "Only your saved rich note will update the reviewed Anytype object. The original engine will check its version again before writing. Both full versions are retained.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only your saved rich note will update the reviewed Anytype object. The original engine will check its version again before writing. Both full versions are retained."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק ההערה העשירה השמורה תעדכן את אובייקט Anytype שנבדק. המנוע המקורי יבדוק שוב את גרסתו לפני הכתיבה. שתי הגרסאות המלאות נשמרות."
          }
        }
      }
    },
