{
  "sourceLanguage": "en",
  "strings": {
    "Checking the saved note…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking the saved note…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בודק את ההערה השמורה…"
          }
        }
      }
    },
    "Close": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגור"
          }
        }
      }
    },
    "Close the editor and reopen the note to check the saved version.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Close the editor and reopen the note to check the saved version."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סגור את העורך ופתח מחדש את ההערה כדי לבדוק את הגרסה השמורה."
          }
        }
      }
    },
    "Continue editing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Continue editing"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך בעריכה"
          }
        }
      }
    },
    "Discard draft": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard draft"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בטל טיוטה"
          }
        }
      }
    },
    "Discard this draft?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discard this draft?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לבטל את הטיוטה?"
          }
        }
      }
    },
    "Expanded note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Expanded note"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערה מורחבת"
          }
        }
      }
    },
    "Note saved": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Note saved"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערה נשמרה"
          }
        }
      }
    },
    "Open expanded editor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open expanded editor"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח בעורך המורחב"
          }
        }
      }
    },
    "Opening the saved note…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opening the saved note…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את ההערה השמורה…"
          }
        }
      }
    },
    "Save": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור"
          }
        }
      }
    },
    "Save this note before opening the expanded editor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save this note before opening the expanded editor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את ההערה לפני פתיחתה בעורך המורחב."
          }
        }
      }
    },
    "Save your text, style and tag changes first.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save your text, style and tag changes first."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור תחילה את השינויים בטקסט, בסגנון ובתגיות."
          }
        }
      }
    },
    "Saving note…": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saving note…"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שומר את ההערה…"
          }
        }
      }
    },
    "The editor could not finish": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor could not finish"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה לא הושלמה"
          }
        }
      }
    },
    "The editor has closed.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The editor has closed."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העורך נסגר."
          }
        }
      }
    },
    "The expanded editor is unavailable for this note.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The expanded editor is unavailable for this note."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העורך המורחב אינו זמין להערה זו."
          }
        }
      }
    },
    "The formatted note is stored on this device.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The formatted note is stored on this device."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערה המעוצבת נשמרת במכשיר זה."
          }
        }
      }
    },
    "The full note has been saved. You can close the editor.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The full note has been saved. You can close the editor."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערה המלאה נשמרה. אפשר לסגור את העורך."
          }
        }
      }
    },
    "The saved note could not be checked. Close and reopen it before editing.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved note could not be checked. Close and reopen it before editing."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לבדוק את ההערה השמורה. סגור אותה ופתח מחדש לפני העריכה."
          }
        }
      }
    },
    "The saved note will stay unchanged.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved note will stay unchanged."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערה השמורה לא תשתנה."
          }
        }
      }
    },
    "This note changed. Close this sheet and open the note again.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note changed. Close this sheet and open the note again."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערה השתנתה. סגור את החלון ופתח אותה מחדש."
          }
        }
      }
    },
    "This note has rich formatting. Use the expanded editor to preserve it.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note has rich formatting. Use the expanded editor to preserve it."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הערה זו כוללת עיצוב עשיר. השתמש בעורך המורחב כדי לשמור עליו."
          }
        }
      }
    },
    "Use the expanded editor to change this formatted note.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the expanded editor to change this formatted note."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בעורך המורחב כדי לשנות את ההערה המעוצבת."
          }
        }
      }
    }
  },
  "version": "1.0"
}
