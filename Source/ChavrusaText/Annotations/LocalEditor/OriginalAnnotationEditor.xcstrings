          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Anytype דחה את העדכון לפני הכתיבה משום שהגרסה השמורה השתנתה. שתי הגרסאות שנבדקו נשמרות. יש לסגור ולבדוק מחדש את הגרסאות העדכניות."
          }
