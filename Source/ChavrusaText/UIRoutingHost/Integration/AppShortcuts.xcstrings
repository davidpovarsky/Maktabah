{
  "sourceLanguage": "en",
  "strings": {
    "Show saved search result in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצגת תוצאת חיפוש שמורה ב־${applicationName}"
          }
        }
      }
    },
    "Resume reading ${entry} in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המשך לקרוא את ${entry} באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Show search result ${result} in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג את תוצאת החיפוש ${result} באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Load next search page in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "טען את עמוד החיפוש הבא באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Open study profile ${selection} in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת פרופיל הלימוד ${selection} באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Open tab group ${selection} in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת קבוצת הטאבים ${selection} באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Open ${destination} in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את ${destination} באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Open ${book} in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את הספר ${book} באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Show search results in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג תוצאות חיפוש באפליקציה ${applicationName}"
          }
        }
      }
    },
    "Open reader tab ${tab} in ${applicationName}": {
      "localizations": {
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתיחת כרטיסיית הקריאה ${tab} באפליקציה ${applicationName}"
          }
        }
      }
    }
  },
  "version": "1.0"
}
