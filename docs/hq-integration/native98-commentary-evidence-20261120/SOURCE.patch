+                    "GITHUB_RUN_ATTEMPT": "1", "GITHUB_SHA": self.git("rev-parse", "HEAD").strip(),
+                    "GITHUB_RUN_ID": "1", "GITHUB_WORKFLOW_REF": f"{M.REPOSITORY}/{M.WORKFLOW}@refs/heads/{M.BRANCH}"}
+        self.env["GITHUB_WORKFLOW_SHA"] = self.env["GITHUB_SHA"]
