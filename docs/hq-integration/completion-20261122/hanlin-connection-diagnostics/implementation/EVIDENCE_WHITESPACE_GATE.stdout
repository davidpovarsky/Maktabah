ting files:  42% (3560/8474)\rUpdating files:  43% (3644/8474)\rUpdating files:  43% (3717/8474)\rUpdating files:  44% (3729/8474)\rUpdating files:  45% (3814/8474)\rUpdating files:  46% (3899/8474)\rUpdating files:  46% (3911/8474)\rUpdating files:  47% (3983/8474)\rUpdating files:  47% (4062/8474)\rUpdating files:  48% (4068/8474)\rUpdating files:  48% (4143/8474)\rUpdating files:  49% (4153/8474)\rUpdating files:  50% (4237/8474)\rUpdating files:  50% (4255/8474)\rUpdating files:  51% (4322/8474)\rUpdating files:  52% (4407/8474)\rUpdating files:  52% (4418/8474)\rUpdating files:  53% (4492/8474)\rUpdating files:  54% (4576/8474)\rUpdating files:  54% (4577/8474)\rUpdating files:  55% (4661/8474)\rUpdating files:  56% (4746/8474)\rUpdating files:  56% (4764/8474)\rUpdating files:  57% (4831/8474)\rUpdating files:  57% (4836/8474)\rUpdating files:  58% (4915/8474)\rUpdating files:  59% (5000/8474)\rUpdating files:  59% (5006/8474)\rUpdating files:  60% (5085/8474)\rUpdating files:  60% (5149/8474)\rUpdating files:  61% (5170/8474)\rUpdating files:  62% (5254/8474)\rUpdating files:  63% (5339/8474)\rUpdating files:  63% (5341/8474)\rUpdating files:  64% (5424/8474)\rUpdating files:  64% (5430/8474)\rUpdating files:  65% (5509/8474)\rUpdating files:  65% (5531/8474)\rUpdating files:  66% (5593/8474)\rUpdating files:  66% (5664/8474)\rUpdating files:  67% (5678/8474)\rUpdating files:  68% (5763/8474)\rUpdating files:  69% (5848/8474)\rUpdating files:  69% (5879/8474)\rUpdating files:  70% (5932/8474)\rUpdating files:  71% (6017/8474)\rUpdating files:  72% (6102/8474)\rUpdating files:  72% (6120/8474)\rUpdating files:  73% (6187/8474)\rUpdating files:  74% (6271/8474)\rUpdating files:  74% (6332/8474)\rUpdating files:  75% (6356/8474)\rUpdating files:  76% (6441/8474)\rUpdating files:  76% (6490/8474)\rUpdating files:  77% (6525/8474)\rUpdating files:  78% (6610/8474)\rUpdating files:  78% (6611/8474)\rUpdating files:  79% (6695/8474)\rUpdating files:  79% (6713/8474)