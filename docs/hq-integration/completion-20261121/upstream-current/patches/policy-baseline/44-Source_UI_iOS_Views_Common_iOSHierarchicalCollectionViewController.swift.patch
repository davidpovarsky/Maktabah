+    /// An occurrence belongs to its complete catalog path. Localized leaf
+    /// titles alone cannot identify repeated categories in different branches.
+    var accessibilityPathIdentifier: String {
+        let components = path.map { [$0.kind.rawValue, $0.title, String($0.siblingOccurrence)] }
+        guard let bytes = try? JSONEncoder().encode(components) else { return "library-tree-invalid" }
+        return "library-tree-path-" + bytes.base64EncodedString()
+    }
