+}
+private struct FullV40NaturalInspectorCatalog: Decodable {
+    let schema: Int
+    let corpusProfile: String
+    let status: String
+    let databaseSHA256: String
+    let scales: [FullV40NaturalInspectorScale]
+    let compileInputsSHA256: String
