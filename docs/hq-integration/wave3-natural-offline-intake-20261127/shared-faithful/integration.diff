+                "atLeastRequestedCount": qualified.originalMetadataCount >= required,
+                "exactRequestedCount": qualified.originalMetadataCount == required,
+                "scope": "separate complete natural unit with actual count: full original Swift metadata plus real native cache/row/scroll; nine exploration outcomes retained independently"
+            ]
+            scales.append(scale)
+            try fullV32Attach(scale, "full-v32-inspector-natural-scale-" + String(required))
+            context = try fullV32CloseOriginalInspector(context, target: target, before: before)
+        }
