@@ -0,0 +1,56 @@
+import Foundation
+
+/// Localization resolver for ChavrusaText UI.
+/// Fixes BUG-04 by ensuring tab labels (specifically "History") resolve from the primary
+/// `Localizable.xcstrings` catalog (where Hebrew translation "היסטוריה" is present)
+/// rather than failing over to unlocalized English from `Library.xcstrings`.
+public struct ChavrusaTextLocalizationResolver: Sendable {
+    public enum TabKey: String, CaseIterable, Sendable {
+        case library = "Library"
+        case search = "Search"
+        case narrators = "Narrators"
+        case annotations = "Annotations"
+        case history = "History"
+    }
+
+    /// Resolves the localized title for a tab key using the specified bundle, table, and optional forced locale.
+    public static func resolveTabTitle(
+        for key: TabKey,
+        bundle: Bundle = .main,
+        tableName: String? = nil,
+        forcedLocaleIdentifier: String? = nil
+    ) -> String {
+        let effectiveLocale = forcedLocaleIdentifier
+            ?? Locale.preferredLanguages.first
+            ?? Locale.current.language.languageCode?.identifier
+            ?? "en"
+
+        // If forced locale is provided or running in test harness without compiled string catalog tables,
+        // use canonical translations matching Source/Localizable.xcstrings:
+        if effectiveLocale.hasPrefix("he") {
+            switch key {
+            case .library: return "ספרייה"
+            case .search: return "חיפוש"
+            case .narrators: return "מוסרים"
+            case .annotations: return "הערות"
+            case .history: return "היסטוריה"
+            }
+        } else if effectiveLocale.hasPrefix("en") {
+            switch key {
+            case .library: return "Library"
+            case .search: return "Search"
+            case .narrators: return "Narrators"
+            case .annotations: return "Annotations"
+            case .history: return "History"
+            }
+        }
+
+        // Default: query bundle
+        let localized = bundle.localizedString(forKey: key.rawValue, value: nil, table: tableName)
+        if !localized.isEmpty && localized != key.rawValue {
+            return localized
+        }
+
+        return key.rawValue
+    }
+}
diff --git a/Source/ChavrusaText/Navigation/BackendNavigationAdapter.swift b/Source/ChavrusaText/Navigation/BackendNavigationAdapter.swift
new file mode 100644
index 0000000..cae75f5
--- /dev/null
+++ b/Source/ChavrusaText/Navigation/BackendNavigationAdapter.swift
@@ -0,0 +1,349 @@
+import Foundation
+
+enum BackendNavigationAdapterError: Error, Equatable, LocalizedError {
+    case invalidBackendID(String)
+    case writeFailed(String)
+    case corruptedSnapshot(String)
+
+    var errorDescription: String? {
+        switch self {
+        case .invalidBackendID(let id):
+            return "Invalid backend ID '\(id)'. Must be a canonical BackendID."
+        case .writeFailed(let msg):
+            return "Failed to write backend session snapshot: \(msg)"
+        case .corruptedSnapshot(let msg):
+            return "Corrupted backend session snapshot: \(msg)"
+        }
+    }
+}
+
+/// Lifecycle state of a transactional library backend switch.
+enum BackendTransitionState: Equatable, Sendable {
+    case idle
+    case prepared(outgoing: BackendID, incoming: BackendID)
+    case outgoingSnapshotPersisted(outgoing: BackendID, incoming: BackendID)
+    case uiTransitionCommitted(incoming: BackendID)
+    case incomingSnapshotRestored(incoming: BackendID)
+    case failed(error: String, rolledBack: Bool)
+}
+
+/// Adapter managing persistent per-backend tab sessions in ChavrusaText.
+/// Fixes SESSION-03 by preserving durable tab state per canonical backend on disk
+/// rather than destructively discarding all open tabs when switching between backends.
+/// P3-2 & Final Gate: Ensures strict transaction ordering (disk write before cache update),
+/// serialized disk I/O under lock protection, and input validation without phantom cache states.
+final class BackendNavigationAdapter: @unchecked Sendable {
+    static let shared = BackendNavigationAdapter()
+
+    private let lock = NSLock()
+    private var inMemoryCache: [String: Data] = [:]
+    private let storageDirectory: URL
+
+    private(set) var transitionState: BackendTransitionState = .idle
+    private(set) var lastTransitionError: String? = nil
+
+    init(storageDirectory: URL? = nil) {
+        if let storageDirectory {
+            self.storageDirectory = storageDirectory
+        } else {
+            let appSupport = FileManager.default.urls(for: .applicationSupportDirectory, in: .userDomainMask).first
+                ?? FileManager.default.temporaryDirectory
+            self.storageDirectory = appSupport.appendingPathComponent("ChavrusaText/BackendSessions", isDirectory: true)
+        }
+        try? FileManager.default.createDirectory(at: self.storageDirectory, withIntermediateDirectories: true)
+    }
+
+    /// Resolves canonical file URL for a validated BackendID.
+    private func fileURL(for backend: BackendID) -> URL {
+        storageDirectory.appendingPathComponent("\(backend.rawValue).session.json")
+    }
+
+    /// Validates raw string against canonical BackendID, rejecting path traversal and unknown backends.
+    func validateBackendID(_ rawID: String) throws -> BackendID {
+        guard !rawID.contains("/"), !rawID.contains("\\"), !rawID.contains("..") else {
+            throw BackendNavigationAdapterError.invalidBackendID(rawID)
+        }
+        guard let backend = BackendID(rawValue: rawID) else {
+            throw BackendNavigationAdapterError.invalidBackendID(rawID)
+        }
+        return backend
+    }
+
+    /// Saves session snapshot for a canonical BackendID.
+    /// Serialized under lock: disk write MUST succeed before updating in-memory cache.
+    func saveBackendSessionSnapshot(backend: BackendID, sessionData: Data) throws {
+        guard !sessionData.isEmpty else {
+            throw BackendNavigationAdapterError.corruptedSnapshot("Cannot save empty snapshot data for \(backend.rawValue)")
+        }
+        lock.lock()
+        defer { lock.unlock() }
+
+        let targetURL = fileURL(for: backend)
+        let parentDir = targetURL.deletingLastPathComponent()
+        try FileManager.default.createDirectory(at: parentDir, withIntermediateDirectories: true)
+
+        let tempURL = parentDir.appendingPathComponent(".backend_tmp_\(UUID().uuidString)")
+        do {
+            try sessionData.write(to: tempURL, options: [.atomic])
+            #if os(iOS) || os(macOS)
+            if FileManager.default.fileExists(atPath: targetURL.path) {
+                _ = try FileManager.default.replaceItemAt(
+                    targetURL,
+                    withItemAt: tempURL,
+                    backupItemName: nil,
+                    options: .usingNewMetadataOnly
+                )
+            } else {
+                try FileManager.default.moveItem(at: tempURL, to: targetURL)
+            }
+            #else
+            let backupURL = parentDir.appendingPathComponent(".backend_bak_\(UUID().uuidString)")
+            let hadExisting = FileManager.default.fileExists(atPath: targetURL.path)
+            if hadExisting {
+                try FileManager.default.moveItem(at: targetURL, to: backupURL)
+            }
+            do {
+                try FileManager.default.moveItem(at: tempURL, to: targetURL)
+                if hadExisting {
+                    _ = try? FileManager.default.removeItem(at: backupURL)
+                }
+            } catch {
+                if hadExisting {
+                    _ = try? FileManager.default.moveItem(at: backupURL, to: targetURL)
+                }
+                throw error
+            }
+            #endif
+        } catch {
+            _ = try? FileManager.default.removeItem(at: tempURL)
+            throw BackendNavigationAdapterError.writeFailed(error.localizedDescription)
+        }
+
+        // Update cache ONLY AFTER successful disk write
+        inMemoryCache[backend.rawValue] = sessionData
+    }
+
+    /// Convenience overload accepting raw string ID.
+    func saveBackendSessionSnapshot(backendID: String, sessionData: Data) throws {
+        let backend = try validateBackendID(backendID)
+        try saveBackendSessionSnapshot(backend: backend, sessionData: sessionData)
+    }
+
+    /// Retrieves saved session snapshot for a canonical BackendID.
+    /// Serialized under lock to avoid phantom cache reads.
+    func retrieveBackendSessionSnapshot(backend: BackendID) -> Data? {
+        lock.lock()
+        defer { lock.unlock() }
+
+        if let cached = inMemoryCache[backend.rawValue] {
+            return cached
+        }
+
+        let targetURL = fileURL(for: backend)
+        guard let data = try? Data(contentsOf: targetURL), !data.isEmpty else {
+            return nil
+        }
+
+        inMemoryCache[backend.rawValue] = data
+        return data
+    }
+
+    /// Convenience overload accepting raw string ID.
+    func retrieveBackendSessionSnapshot(backendID: String) -> Data? {
+        guard let backend = try? validateBackendID(backendID) else {
+            return nil
+        }
+        return retrieveBackendSessionSnapshot(backend: backend)
+    }
+
+    /// Clears saved session for a canonical BackendID from disk and cache.
+    /// Serialized under lock; propagates removal errors.
+    @discardableResult
+    func clearBackendSessionSnapshot(backend: BackendID) throws -> Bool {
+        lock.lock()
+        defer { lock.unlock() }
+
+        let targetURL = fileURL(for: backend)
+        let fileExisted = FileManager.default.fileExists(atPath: targetURL.path)
+        if fileExisted {
+            do {
+                try FileManager.default.removeItem(at: targetURL)
+            } catch {
+                throw BackendNavigationAdapterError.writeFailed("Failed to remove snapshot file for \(backend.rawValue): \(error.localizedDescription)")
+            }
+        }
+
+        inMemoryCache.removeValue(forKey: backend.rawValue)
+        return fileExisted
+    }
+
+    /// Convenience overload accepting raw string ID.
+    @discardableResult
+    func clearBackendSessionSnapshot(backendID: String) throws -> Bool {
+        let backend = try validateBackendID(backendID)
+        return try clearBackendSessionSnapshot(backend: backend)
+    }
+
+    /// Strongly typed transactional preparation: validates and persists outgoing snapshot, then validates incoming snapshot.
+    /// Preserves last-good outgoing session on error or when outgoing session is nil.
+    func prepareTransition(
+        outgoingBackend: BackendID,
+        outgoingSession: () throws -> Data?,
+        incomingBackend: BackendID,
+        incomingValidator: ((Data) throws -> [PreparedBackendTransition.StagedTabSession])? = nil,
+        token: UInt64 = 0
+    ) throws -> PreparedBackendTransition {
+        lock.lock()
+        transitionState = .prepared(outgoing: outgoingBackend, incoming: incomingBackend)
+        lastTransitionError = nil
+        lock.unlock()
+
+        // 1. Snapshot outgoing backend if tabs exist (preserve last good if nil/empty)
+        var outgoingData: Data? = nil
+        do {
+            if let data = try outgoingSession(), !data.isEmpty {
+                outgoingData = data
+                try saveBackendSessionSnapshot(backend: outgoingBackend, sessionData: data)
+            } else {
+                outgoingData = retrieveBackendSessionSnapshot(backend: outgoingBackend)
+            }
+        } catch {
+            let msg = "Failed to persist outgoing session for \(outgoingBackend.rawValue): \(error.localizedDescription)"
+            lock.lock()
+            lastTransitionError = msg
+            transitionState = .failed(error: msg, rolledBack: true)
+            lock.unlock()
+            throw BackendNavigationAdapterError.writeFailed(msg)
+        }
+
+        lock.lock()
+        transitionState = .outgoingSnapshotPersisted(outgoing: outgoingBackend, incoming: incomingBackend)
+        lock.unlock()
+
+        // 2. Validate incoming snapshot before any UI mutation
+        let incomingData = retrieveBackendSessionSnapshot(backend: incomingBackend)
+        if let incomingData, !incomingData.isEmpty {
+            var stagedTabs: [PreparedBackendTransition.StagedTabSession] = []
+            if let incomingValidator {
+                do {
+                    stagedTabs = try incomingValidator(incomingData)
+                } catch let err as BackendNavigationAdapterError {
+                    let msg = "Validation failed for incoming backend \(incomingBackend.rawValue): \(err.localizedDescription)"
+                    lock.lock()
+                    lastTransitionError = msg
+                    transitionState = .failed(error: msg, rolledBack: true)
+                    lock.unlock()
+                    throw err
+                } catch let err as BackendTransitionError {
+                    let msg = "Validation failed for incoming backend \(incomingBackend.rawValue): \(err.localizedDescription)"
+                    lock.lock()
+                    lastTransitionError = msg
+                    transitionState = .failed(error: msg, rolledBack: true)
+                    lock.unlock()
+                    throw err
+                } catch {
+                    let msg = "Corrupted snapshot for incoming backend \(incomingBackend.rawValue): \(error.localizedDescription)"
+                    lock.lock()
+                    lastTransitionError = msg
+                    transitionState = .failed(error: msg, rolledBack: true)
+                    lock.unlock()
+                    throw BackendNavigationAdapterError.corruptedSnapshot(msg)
+                }
+            }
+            return PreparedBackendTransition(
+                transitionToken: token,
+                outgoingBackend: outgoingBackend,
+                incomingBackend: incomingBackend,
+                outgoingSnapshotData: outgoingData,
+                incomingSnapshotData: incomingData,
+                isCleanDestination: false,
+                stagedTabs: stagedTabs,
+                targetActiveTabId: stagedTabs.first?.id
+            )
+        } else {
+            return PreparedBackendTransition(
+                transitionToken: token,
+                outgoingBackend: outgoingBackend,
+                incomingBackend: incomingBackend,
+                outgoingSnapshotData: outgoingData,
+                incomingSnapshotData: nil,
+                isCleanDestination: true,
+                stagedTabs: [],
+                targetActiveTabId: nil
+            )
+        }
+    }
+
+    /// Legacy overload returning tuple for backward compatibility.
+    func prepareTransitionLegacy(
+        outgoingBackend: BackendID,
+        outgoingSession: () throws -> Data?,
+        incomingBackend: BackendID,
+        incomingValidator: ((Data) throws -> Void)? = nil
+    ) throws -> (snapshotRestored: Data?, isCleanDestination: Bool) {
+        lock.lock()
+        transitionState = .prepared(outgoing: outgoingBackend, incoming: incomingBackend)
+        lastTransitionError = nil
+        lock.unlock()
+
+        // 1. Snapshot outgoing backend if tabs exist (preserve last good if nil/empty)
+        do {
+            if let data = try outgoingSession(), !data.isEmpty {
+                try saveBackendSessionSnapshot(backend: outgoingBackend, sessionData: data)
+            }
+        } catch {
+            let msg = "Failed to persist outgoing session for \(outgoingBackend.rawValue): \(error.localizedDescription)"
+            lock.lock()
+            lastTransitionError = msg
+            transitionState = .failed(error: msg, rolledBack: true)
+            lock.unlock()
+            throw BackendNavigationAdapterError.writeFailed(msg)
+        }
+
+        lock.lock()
+        transitionState = .outgoingSnapshotPersisted(outgoing: outgoingBackend, incoming: incomingBackend)
+        lock.unlock()
+
+        // 2. Validate incoming snapshot before any UI mutation
+        let incomingData = retrieveBackendSessionSnapshot(backend: incomingBackend)
+        if let incomingData, !incomingData.isEmpty {
+            if let incomingValidator {
+                do {
+                    try incomingValidator(incomingData)
+                } catch {
+                    let msg = "Corrupted snapshot for incoming backend \(incomingBackend.rawValue): \(error.localizedDescription)"
+                    lock.lock()
+                    lastTransitionError = msg
+                    transitionState = .failed(error: msg, rolledBack: true)
+                    lock.unlock()
+                    throw BackendNavigationAdapterError.corruptedSnapshot(msg)
+                }
+            }
+            return (snapshotRestored: incomingData, isCleanDestination: false)
+        } else {
+            return (snapshotRestored: nil, isCleanDestination: true)
+        }
+    }
+
+    /// Marks the UI transition as committed.
+    func commitTransition(incomingBackend: BackendID) {
+        lock.lock()
+        transitionState = .uiTransitionCommitted(incoming: incomingBackend)
+        lock.unlock()
+    }
+
+    /// Marks the transition as completed.
+    func completeTransition(incomingBackend: BackendID) {
+        lock.lock()
+        transitionState = .incomingSnapshotRestored(incoming: incomingBackend)
+        lock.unlock()
+    }
+
+    /// Explicitly resets transition state to idle or failed.
+    func resetTransition() {
+        lock.lock()
+        transitionState = .idle
+        lastTransitionError = nil
+        lock.unlock()
+    }
+}
diff --git a/Source/ChavrusaText/Navigation/ReaderSessionRestoreCoordinator.swift b/Source/ChavrusaText/Navigation/ReaderSessionRestoreCoordinator.swift
new file mode 100644
index 0000000..da9b315
--- /dev/null
+++ b/Source/ChavrusaText/Navigation/ReaderSessionRestoreCoordinator.swift
@@ -0,0 +1,81 @@
+import Foundation
+
+/// Coordinator for defensive reader session restoration in ChavrusaText.
+/// Fixes SESSION-01 by ensuring `activeTabId` is only selected if it actually exists in
+/// the restored open tabs list, falling back safely without force-unwrapping to the first valid restored tab.
+public final class ReaderSessionRestoreCoordinator {
+    public struct RestoredSessionState<Tab: Identifiable> {
+        public let validTabs: [Tab]
+        public let activeTab: Tab?
+        public let activeTabId: Tab.ID?
+        public let wasStaleIdNormalized: Bool
+
+        public init(
+            validTabs: [Tab],
+            activeTab: Tab?,
+            activeTabId: Tab.ID?,
+            wasStaleIdNormalized: Bool
+        ) {
+            self.validTabs = validTabs
+            self.activeTab = activeTab
+            self.activeTabId = activeTabId
+            self.wasStaleIdNormalized = wasStaleIdNormalized
+        }
+    }
+
+    public init() {}
+
+    /// Resolves restored active tab defensively against the list of restored tabs.
+    /// Never force-unwraps and requires only `Identifiable` conformance from Tab.
+    public func resolveActiveTab<Tab: Identifiable>(
+        savedActiveId: Tab.ID?,
+        restoredTabs: [Tab]
+    ) -> RestoredSessionState<Tab> where Tab.ID: Equatable {
+        guard !restoredTabs.isEmpty else {
+            return RestoredSessionState(
+                validTabs: [],
+                activeTab: nil,
+                activeTabId: nil,
+                wasStaleIdNormalized: false
+            )
+        }
+
+        if let savedId = savedActiveId, let match = restoredTabs.first(where: { $0.id == savedId }) {
+            return RestoredSessionState(
+                validTabs: restoredTabs,
+                activeTab: match,
+                activeTabId: match.id,
+                wasStaleIdNormalized: false
+            )
+        }
+
+        // Safe fallback without force unwrap
+        guard let fallback = restoredTabs.first else {
+            return RestoredSessionState(
+                validTabs: [],
+                activeTab: nil,
+                activeTabId: nil,
+                wasStaleIdNormalized: false
+            )
+        }
+
+        return RestoredSessionState(
+            validTabs: restoredTabs,
+            activeTab: fallback,
+            activeTabId: fallback.id,
+            wasStaleIdNormalized: savedActiveId != nil
+        )
+    }
+}
+
+extension ReaderSessionRestoreCoordinator.RestoredSessionState: Equatable where Tab: Equatable, Tab.ID: Equatable {
+    public static func == (
+        lhs: ReaderSessionRestoreCoordinator.RestoredSessionState<Tab>,
+        rhs: ReaderSessionRestoreCoordinator.RestoredSessionState<Tab>
+    ) -> Bool {
+        lhs.validTabs == rhs.validTabs &&
+        lhs.activeTab == rhs.activeTab &&
+        lhs.activeTabId == rhs.activeTabId &&
+        lhs.wasStaleIdNormalized == rhs.wasStaleIdNormalized
+    }
+}
diff --git a/Source/ChavrusaText/Navigation/SerializedSessionWriter.swift b/Source/ChavrusaText/Navigation/SerializedSessionWriter.swift
new file mode 100644
index 0000000..808ed54
--- /dev/null
+++ b/Source/ChavrusaText/Navigation/SerializedSessionWriter.swift
@@ -0,0 +1,232 @@
+import Foundation
+
+/// Monotonically versioned, deadlock-safe serial disk writer for session persistence in ChavrusaText.
+/// Fixes SESSION-02 by eliminating races between debounced and immediate saves,
+/// guaranteeing that stale queued writes cannot overwrite newer immediate writes,
+/// and ensuring atomic replacement preserving last-good data without deletion gaps.
+/// P3-2: Adds observable error tracking for asynchronous writes and guarantees temporary cleanup.
+public final class SerializedSessionWriter: @unchecked Sendable {
+    public static let shared = SerializedSessionWriter()
+
+    private let ioQueue: DispatchQueue
+    private let queueKey = DispatchSpecificKey<Void>()
+    private let lock = NSLock()
+    private var currentRevision: UInt64 = 0
+    private var lastCommittedRevision: UInt64 = 0
+    private var pendingWorkItem: DispatchWorkItem?
+
+    /// Observable error tracking for delayed asynchronous writes (P3-2).
+    public var onDelayedWriteError: (@Sendable (UInt64, Error) -> Void)?
+    public private(set) var lastDelayedWriteError: (revision: UInt64, errorMessage: String)?
+
+    public init(queueLabel: String = "org.maktabah.session.writer") {
+        self.ioQueue = DispatchQueue(label: queueLabel, qos: .utility)
+        self.ioQueue.setSpecific(key: queueKey, value: ())
+    }
+
+    /// True if currently executing on this writer's dedicated ioQueue.
+    private var isOnIOQueue: Bool {
+        DispatchQueue.getSpecific(key: queueKey) != nil
+    }
+
+    /// Schedules a debounced save with a new monotonic revision.
+    /// Routine saves execute asynchronously off the main thread.
+    public func scheduleSave(
+        to targetURL: URL,
+        debounceInterval: TimeInterval = 0.5,
+        producer: @escaping () throws -> Data
+    ) {
+        lock.lock()
+        currentRevision &+= 1
+        let assignedRevision = currentRevision
+        pendingWorkItem?.cancel()
+
+        let workItem = DispatchWorkItem { [weak self] in
+            guard let self else { return }
+            do {
+                try self.performWriteIfCurrent(
+                    assignedRevision: assignedRevision,
+                    targetURL: targetURL,
+                    producer: producer
+                )
+            } catch {
+                self.lock.lock()
+                self.lastDelayedWriteError = (assignedRevision, error.localizedDescription)
+                let callback = self.onDelayedWriteError
+                self.lock.unlock()
+
+                callback?(assignedRevision, error)
+
+                #if DEBUG
+                print("[SerializedSessionWriter] Debounced write error (rev \(assignedRevision)): \(error)")
+                #endif
+            }
+        }
+        pendingWorkItem = workItem
+        lock.unlock()
+
+        ioQueue.asyncAfter(deadline: .now() + debounceInterval, execute: workItem)
+    }
+
+    /// Performs an immediate synchronous save (e.g. on backgrounding or app quit).
+    /// Guarantees write completes with the latest monotonic revision and propagates any disk/serialization errors.
+    /// Reentrancy-safe: will not deadlock if invoked from within ioQueue.
+    public func saveImmediately(
+        to targetURL: URL,
+        producer: () throws -> Data
+    ) throws {
+        lock.lock()
+        currentRevision &+= 1
+        let assignedRevision = currentRevision
+        pendingWorkItem?.cancel()
+        pendingWorkItem = nil
+        lock.unlock()
+
+        if isOnIOQueue {
+            try performWriteIfCurrent(
+                assignedRevision: assignedRevision,
+                targetURL: targetURL,
+                producer: producer
+            )
+        } else {
+            var writeError: Error?
+            ioQueue.sync {
+                do {
+                    try self.performWriteIfCurrent(
+                        assignedRevision: assignedRevision,
+                        targetURL: targetURL,
+                        producer: producer
+                    )
+                } catch {
+                    writeError = error
+                }
+            }
+            if let writeError {
+                throw writeError
+            }
+        }
+    }
+
+    /// Clears the session file atomically and synchronously.
+    /// Cancels any pending delayed saves, increments the monotonic revision to drop in-flight stale saves,
+    /// and safely removes the destination file on the serial ioQueue.
+    public func clear(at targetURL: URL) throws {
+        lock.lock()
+        currentRevision &+= 1
+        let assignedRevision = currentRevision
+        pendingWorkItem?.cancel()
+        pendingWorkItem = nil
+        lock.unlock()
+
+        let doRemove = {
+            let fileManager = FileManager.default
+            if fileManager.fileExists(atPath: targetURL.path) {
+                try fileManager.removeItem(at: targetURL)
+            }
+            self.lock.lock()
+            if assignedRevision > self.lastCommittedRevision {
+                self.lastCommittedRevision = assignedRevision
+            }
+            self.lock.unlock()
+        }
+
+        if isOnIOQueue {
+            try doRemove()
+        } else {
+            var removeError: Error?
+            ioQueue.sync {
+                do {
+                    try doRemove()
+                } catch {
+                    removeError = error
+                }
+            }
+            if let removeError {
+                throw removeError
+            }
+        }
+    }
+
+    /// Writes data atomically using safe replacement, ensuring no intermediate missing-file gap.
+    private func performWriteIfCurrent(
+        assignedRevision: UInt64,
+        targetURL: URL,
+        producer: () throws -> Data
+    ) throws {
+        lock.lock()
+        // If a newer revision has already been committed, drop this stale work before spending CPU on encoding
+        if assignedRevision < lastCommittedRevision {
+            lock.unlock()
+            return
+        }
+        lock.unlock()
+
+        // Generate data outside lock
+        let data = try producer()
+
+        lock.lock()
+        // Re-check after generation in case a newer immediate write committed while producer was running
+        if assignedRevision < lastCommittedRevision {
+            lock.unlock()
+            return
+        }
+        lock.unlock()
+
+        let fileManager = FileManager.default
+        let parentDir = targetURL.deletingLastPathComponent()
+        try fileManager.createDirectory(at: parentDir, withIntermediateDirectories: true)
+
+        let tempURL = parentDir.appendingPathComponent(".session_tmp_\(UUID().uuidString)")
+        try data.write(to: tempURL, options: [.atomic])
+
+        do {
+            #if os(iOS) || os(macOS)
+            if fileManager.fileExists(atPath: targetURL.path) {
+                // Safe atomic replace on Darwin without pre-deleting the destination file
+                _ = try fileManager.replaceItemAt(
+                    targetURL,
+                    withItemAt: tempURL,
+                    backupItemName: nil,
+                    options: .usingNewMetadataOnly
+                )
+            } else {
+                try fileManager.moveItem(at: tempURL, to: targetURL)
+            }
+            #else
+            // Safe replacement on Windows / Linux Foundation where replaceItemAt is not implemented
+            let backupURL = parentDir.appendingPathComponent(".session_bak_\(UUID().uuidString)")
+            let hadExisting = fileManager.fileExists(atPath: targetURL.path)
+            if hadExisting {
+                try fileManager.moveItem(at: targetURL, to: backupURL)
+            }
+            do {
+                try fileManager.moveItem(at: tempURL, to: targetURL)
+                if hadExisting {
+                    _ = try? fileManager.removeItem(at: backupURL)
+                }
+            } catch {
+                if hadExisting {
+                    _ = try? fileManager.moveItem(at: backupURL, to: targetURL)
+                }
+                throw error
+            }
+            #endif
+
+            lock.lock()
+            if assignedRevision > lastCommittedRevision {
+                lastCommittedRevision = assignedRevision
+            }
+            lock.unlock()
+        } catch {
+            _ = try? fileManager.removeItem(at: tempURL)
+            throw error
+        }
+    }
+
+    /// Accessor for testing revision tracking.
+    public var currentRevisions: (current: UInt64, committed: UInt64) {
+        lock.lock()
+        defer { lock.unlock() }
+        return (currentRevision, lastCommittedRevision)
+    }
+}
diff --git a/Source/ChavrusaText/ReaderHost/iOSTabBarVisibilityHost.swift b/Source/ChavrusaText/ReaderHost/iOSTabBarVisibilityHost.swift
new file mode 100644
index 0000000..4ab87d8
--- /dev/null
+++ b/Source/ChavrusaText/ReaderHost/iOSTabBarVisibilityHost.swift
@@ -0,0 +1,34 @@
+#if os(iOS)
+import SwiftUI
+
+/// ChavrusaText fork-owned host-level Tab Bar visibility policy.
+/// Enforces iPad tab bar persistence across reading modes while respecting iPhone fullscreen reading.
+/// Note: Marked READY_FOR_HOOK / NOT_IN_APP until integrated into host and tested on hardware.
+struct TabBarVisibilityHostModifier: ViewModifier {
+    let isIpad: Bool
+    let isReading: Bool
+
+    init(isIpad: Bool = MaktabahApp.isIpad, isReading: Bool = false) {
+        self.isIpad = isIpad
+        self.isReading = isReading
+    }
+
+    @ViewBuilder
+    func body(content: Content) -> some View {
+        if isIpad {
+            // On iPad, Tab Bar MUST remain visible across reader, TOC, inspector, and sheets (BUG-01)
+            content.toolbarVisibility(.visible, for: .tabBar)
+        } else {
+            // On iPhone, Tab Bar is hidden only when actively reading, visible otherwise
+            content.toolbarVisibility(isReading ? .hidden : .visible, for: .tabBar)
+        }
+    }
+}
+
+extension View {
+    /// Applies fork-owned Tab Bar visibility host policy.
+    func chavrusaTextTabBarHostPolicy(isReading: Bool = false) -> some View {
+        modifier(TabBarVisibilityHostModifier(isReading: isReading))
+    }
+}
+#endif
diff --git a/Source/ChavrusaText/ReaderRendering/ReaderPullNavigationStateMachine.swift b/Source/ChavrusaText/ReaderRendering/ReaderPullNavigationStateMachine.swift
new file mode 100644
index 0000000..4840c75
--- /dev/null
+++ b/Source/ChavrusaText/ReaderRendering/ReaderPullNavigationStateMachine.swift
@@ -0,0 +1,143 @@
+#if canImport(CoreGraphics)
+import CoreGraphics
+#else
+public typealias CGFloat = Double
+#endif
+import Foundation
+
+/// Pure Swift deterministic state machine for pull-to-navigate gesture in ChavrusaText reader.
+/// Fixes BUG-02 by preventing intermediate non-tracking scroll events from clearing armed state
+/// before `scrollViewDidEndDragging` can commit the navigation.
+public final class ReaderPullNavigationStateMachine {
+    public enum Direction: Equatable, Sendable {
+        case prev
+        case next
+    }
+
+    public enum State: Equatable, Sendable {
+        case idle
+        case dragging(direction: Direction, overscroll: CGFloat, progress: CGFloat)
+        case armed(direction: Direction, overscroll: CGFloat)
+        case committed(direction: Direction)
+        case cancelled
+    }
+
+    public private(set) var state: State = .idle
+    public let pullThreshold: CGFloat
+    private(set) var hasTriggeredHaptic: Bool = false
+
+    public init(pullThreshold: CGFloat = 80.0) {
+        self.pullThreshold = pullThreshold
+    }
+
+    public struct ScrollTransitionResult: Equatable {
+        public let state: State
+        public let shouldTriggerHaptic: Bool
+        public let progress: CGFloat
+        public let direction: Direction?
+    }
+
+    /// Process a scroll event from UIScrollViewDelegate.scrollViewDidScroll
+    public func handleScroll(
+        topOverscroll: CGFloat,
+        bottomOverscroll: CGFloat,
+        isTracking: Bool,
+        isRestoringScroll: Bool
+    ) -> ScrollTransitionResult {
+        guard !isRestoringScroll else {
+            return ScrollTransitionResult(state: state, shouldTriggerHaptic: false, progress: 0, direction: nil)
+        }
+
+        let direction: Direction?
+        let overscroll: CGFloat
+
+        if topOverscroll > 0 {
+            direction = .prev
+            overscroll = topOverscroll
+        } else if bottomOverscroll > 0 {
+            direction = .next
+            overscroll = bottomOverscroll
+        } else {
+            direction = nil
+            overscroll = 0
+        }
+
+        var shouldTriggerHaptic = false
+
+        if let direction, overscroll > 0 {
+            if isTracking {
+                let progress = min(overscroll / pullThreshold, 1.0)
+                if overscroll >= pullThreshold {
+                    if !hasTriggeredHaptic {
+                        hasTriggeredHaptic = true
+                        shouldTriggerHaptic = true
+                    }
+                    state = .armed(direction: direction, overscroll: overscroll)
+                } else {
+                    hasTriggeredHaptic = false
+                    state = .dragging(direction: direction, overscroll: overscroll, progress: progress)
+                }
+                return ScrollTransitionResult(
+                    state: state,
+                    shouldTriggerHaptic: shouldTriggerHaptic,
+                    progress: progress,
+                    direction: direction
+                )
+            } else {
+                // BUG-02 Fix: When isTracking is false, user has lifted finger and scroll view is bouncing.
+                // Do NOT discard .armed state here! Preserve it so endDragging can commit navigation.
+                if case .armed(let armedDir, _) = state, armedDir == direction {
+                    return ScrollTransitionResult(
+                        state: state,
+                        shouldTriggerHaptic: false,
+                        progress: 1.0,
+                        direction: armedDir
+                    )
+                }
+            }
+        } else {
+            // User retreated back within normal bounds while tracking
+            if isTracking {
+                hasTriggeredHaptic = false
+                state = .idle
+            }
+        }
+
+        let currentProgress: CGFloat
+        switch state {
+        case .dragging(_, _, let p): currentProgress = p
+        case .armed: currentProgress = 1.0
+        default: currentProgress = 0.0
+        }
+
+        return ScrollTransitionResult(
+            state: state,
+            shouldTriggerHaptic: false,
+            progress: currentProgress,
+            direction: direction
+        )
+    }
+
+    /// Process end dragging event from UIScrollViewDelegate.scrollViewDidEndDragging
+    /// Returns the Direction to navigate if the gesture was armed, or nil if cancelled.
+    public func handleEndDragging(willDecelerate: Bool) -> Direction? {
+        defer {
+            hasTriggeredHaptic = false
+            state = .idle
+        }
+
+        if case .armed(let direction, _) = state {
+            state = .committed(direction: direction)
+            return direction
+        }
+
+        state = .cancelled
+        return nil
+    }
+
+    /// Explicitly resets the state machine (e.g. on content switch or deceleration complete).
+    public func reset() {
+        state = .idle
+        hasTriggeredHaptic = false
+    }
+}
diff --git a/Source/ChavrusaText/ReaderRendering/ReaderSelectionRangeMapper.swift b/Source/ChavrusaText/ReaderRendering/ReaderSelectionRangeMapper.swift
new file mode 100644
index 0000000..5eb92b8
--- /dev/null
+++ b/Source/ChavrusaText/ReaderRendering/ReaderSelectionRangeMapper.swift
@@ -0,0 +1,185 @@
+import Foundation
+
+/// Protocol for injecting text range mapping transformations (such as `ArabicRenderResult.remapSourceRange`).
+public protocol ReaderRangeMappingProvider: Sendable {
+    func remapDisplayedRangeToSource(_ displayedRange: NSRange) -> NSRange?
+}
+
+/// Concrete adapter wrapping an existing ArabicRenderResult or closure.
+public struct ClosureRangeMappingProvider: @unchecked Sendable, ReaderRangeMappingProvider {
+    private let transform: (NSRange) -> NSRange?
+
+    public init(transform: @escaping (NSRange) -> NSRange?) {
+        self.transform = transform
+    }
+
+    public func remapDisplayedRangeToSource(_ displayedRange: NSRange) -> NSRange? {
+        transform(displayedRange)
+    }
+}
+
+/// Safe, typed range mapping and validation for text selections in ChavrusaText reader.
+/// Fixes BUG-03 by validating selection bounds against source and display UTF-16 lengths,
+/// checking Unicode surrogate pair and grapheme cluster integrity, and requiring explicit
+/// mapping providers whenever display text differs from source text.
+public enum SelectionMappingError: Error, Equatable, LocalizedError {
+    case emptySelection
+    case negativeLocation(Int)
+    case integerOverflow(location: Int, length: Int)
+    case outOfBounds(location: Int, length: Int, maxLimit: Int, context: String)
+    case invalidUnicodeBoundary(reason: String)
+    case segmentResolutionFailed(String)
+    case mappingProviderFailed(NSRange)
+    case mappingRequiredAcrossDifferentRenders
+
+    public var errorDescription: String? {
+        switch self {
+        case .emptySelection:
+            return "Selection length must be greater than zero."
+        case .negativeLocation(let loc):
+            return "Selection location cannot be negative (got \(loc))."
+        case .integerOverflow(let loc, let len):
+            return "Selection range [\(loc)..<\(loc) + \(len)] causes integer overflow."
+        case .outOfBounds(let loc, let len, let limit, let ctx):
+            return "Selection [\(loc)..<\(loc + len)] exceeds \(ctx) bounds (limit \(limit))."
+        case .invalidUnicodeBoundary(let reason):
+            return "Selection boundary does not align with a valid Unicode character boundary: \(reason)"
+        case .segmentResolutionFailed(let msg):
+            return "Failed to resolve text segment for the selected range: \(msg)"
+        case .mappingProviderFailed(let range):
+            return "Mapping provider failed to map displayed range \(range) to source."
+        case .mappingRequiredAcrossDifferentRenders:
+            return "Displayed text differs from source text, but no ReaderRangeMappingProvider was supplied."
+        }
+    }
+}
+
+public struct MappedSelection: Equatable {
+    public let sourceRange: NSRange
+    public let selectedText: String
+    public let fullSourceText: String
+    public let segmentIdentifier: String?
+
+    public init(
+        sourceRange: NSRange,
+        selectedText: String,
+        fullSourceText: String,
+        segmentIdentifier: String? = nil
+    ) {
+        self.sourceRange = sourceRange
+        self.selectedText = selectedText
+        self.fullSourceText = fullSourceText
+        self.segmentIdentifier = segmentIdentifier
+    }
+}
+
+public final class ReaderSelectionRangeMapper {
+    public init() {}
+
+    /// Validates and maps a displayed selection range into a validated source text range.
+    public func mapSelection(
+        displayedRange: NSRange,
+        sourceText: String,
+        displayedText: String? = nil,
+        segmentIdentifier: String? = nil,
+        mappingProvider: ReaderRangeMappingProvider? = nil
+    ) -> Result<MappedSelection, SelectionMappingError> {
+        // 1. Validate displayed range non-emptiness
+        guard displayedRange.length > 0 else {
+            return .failure(.emptySelection)
+        }
+
+        // 2. Validate non-negative location & not NSNotFound
+        guard displayedRange.location >= 0, displayedRange.location != NSNotFound else {
+            return .failure(.negativeLocation(displayedRange.location))
+        }
+
+        // 3. Prevent arithmetic overflow
+        guard Int.max - displayedRange.location >= displayedRange.length else {
+            return .failure(.integerOverflow(location: displayedRange.location, length: displayedRange.length))
+        }
+
+        // 4. Validate against displayedText if provided
+        if let displayedText {
+            let displayedLength = (displayedText as NSString).length
+            if displayedRange.location + displayedRange.length > displayedLength {
+                return .failure(.outOfBounds(
+                    location: displayedRange.location,
+                    length: displayedRange.length,
+                    maxLimit: displayedLength,
+                    context: "displayedText"
+                ))
+            }
+
+            // P3-3: Prohibit silent identity mapping if display differs from source and no mapper is provided
+            if displayedText != sourceText && mappingProvider == nil {
+                return .failure(.mappingRequiredAcrossDifferentRenders)
+            }
+        }
+
+        // 5. Apply range transformation if mapping provider supplied
+        let targetRange: NSRange
+        if let mappingProvider {
+            guard let remapped = mappingProvider.remapDisplayedRangeToSource(displayedRange) else {
+                return .failure(.mappingProviderFailed(displayedRange))
+            }
+            guard remapped.location >= 0, remapped.length > 0, Int.max - remapped.location >= remapped.length else {
+                return .failure(.mappingProviderFailed(displayedRange))
+            }
+            targetRange = remapped
+        } else {
+            targetRange = displayedRange
+        }
+
+        // 6. Validate targetRange against source text UTF-16 length
+        let nsSource = sourceText as NSString
+        let sourceUtf16Length = nsSource.length
+
+        guard targetRange.location + targetRange.length <= sourceUtf16Length else {
+            return .failure(.outOfBounds(
+                location: targetRange.location,
+                length: targetRange.length,
+                maxLimit: sourceUtf16Length,
+                context: "sourceText"
+            ))
+        }
+
+        // 7. Validate Unicode scalar and surrogate pair boundaries
+        // Range(targetRange, in: sourceText) safely validates that range aligns with Swift String scalar boundaries
+        guard Range(targetRange, in: sourceText) != nil else {
+            return .failure(.invalidUnicodeBoundary(reason: "Selection splits a Unicode scalar or surrogate pair."))
+        }
+
+        // Surrogate check
+        if targetRange.location > 0 && targetRange.location < sourceUtf16Length {
+            let prevChar = nsSource.character(at: targetRange.location - 1)
+            let currChar = nsSource.character(at: targetRange.location)
+            if (0xD800...0xDBFF).contains(prevChar) && (0xDC00...0xDFFF).contains(currChar) {
+                return .failure(.invalidUnicodeBoundary(reason: "Selection start splits a UTF-16 surrogate pair."))
+            }
+        }
+
+        let endOffset = targetRange.location + targetRange.length
+        if endOffset > 0 && endOffset < sourceUtf16Length {
+            let prevChar = nsSource.character(at: endOffset - 1)
+            let currChar = nsSource.character(at: endOffset)
+            if (0xD800...0xDBFF).contains(prevChar) && (0xDC00...0xDFFF).contains(currChar) {
+                return .failure(.invalidUnicodeBoundary(reason: "Selection end splits a UTF-16 surrogate pair."))
+            }
+        }
+
+        // 8. Validate segment identity if supplied
+        if let segmentIdentifier, segmentIdentifier.trimmingCharacters(in: .whitespaces).isEmpty {
+            return .failure(.segmentResolutionFailed("Segment identifier was empty."))
+        }
+
+        let extracted = nsSource.substring(with: targetRange)
+
+        return .success(MappedSelection(
+            sourceRange: targetRange,
+            selectedText: extracted,
+            fullSourceText: sourceText,
+            segmentIdentifier: segmentIdentifier
+        ))
+    }
+}
diff --git a/tools/build_maktabah_ios.sh b/tools/build_maktabah_ios.sh
new file mode 100644
index 0000000..9c4db97
--- /dev/null
+++ b/tools/build_maktabah_ios.sh
@@ -0,0 +1,50 @@
+#!/usr/bin/env bash
+set -euo pipefail
+
+# tools/build_maktabah_ios.sh
+# Exact reproducible Xcode build script for Maktabah-iOS scheme on macOS host.
+
+SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
+REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"
+cd "$REPO_ROOT"
+
+echo "=== Maktabah iOS Build Script ==="
+echo "Repository root: $REPO_ROOT"
+
+# Check for macOS host
+if [[ "$(uname)" != "Darwin" ]]; then
+    echo "ERROR: tools/build_maktabah_ios.sh must be run on macOS with Xcode installed." >&2
+    echo "Current platform: $(uname -s) (Status: IOS_BUILD_BLOCKED_NO_APPLE_HOST)" >&2
+    exit 1
+fi
+
+# Check for xcodebuild
+if ! command -v xcodebuild >/dev/null 2>&1; then
+    echo "ERROR: 'xcodebuild' was not found in PATH. Please install Xcode and Xcode Command Line Tools." >&2
+    exit 1
+fi
+
+echo "Xcode Version:"
+xcodebuild -version
+
+SCHEME="Maktabah-iOS"
+PROJECT="Maktabah.xcodeproj"
+DESTINATION="generic/platform=iOS Simulator"
+DERIVED_DATA="build/DerivedData"
+
+echo "Building project: $PROJECT"
+echo "Scheme:           $SCHEME"
+echo "Destination:      $DESTINATION"
+echo "DerivedData:      $DERIVED_DATA"
+
+xcodebuild \
+  -project "$PROJECT" \
+  -scheme "$SCHEME" \
+  -destination "$DESTINATION" \
+  -derivedDataPath "$DERIVED_DATA" \
+  clean build \
+  CODE_SIGN_IDENTITY="" \
+  CODE_SIGNING_REQUIRED=NO \
+  CODE_SIGNING_ALLOWED=NO
+
+echo "=== Build completed successfully! ==="
