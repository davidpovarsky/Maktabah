+        case .success(let m):
+            #expect(m.sourceRange == NSRange(location: 5, length: 5))
+            #expect(m.selectedText == "עליכם")
+        case .failure(let err):
+            #expect(Bool(false), "Unexpected failure with provider: \(err)")
+        }
+    }
