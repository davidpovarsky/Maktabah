+                isSidebarCollapsed: state.isSidebarCollapsed,
+                searchText: vm.searchText.isEmpty ? nil : vm.searchText,
+                searchModeRaw: vm.searchMode?.rawValue,
+                nearDistance: vm.nearDistance,
+                highlightTerms: vm.highlightTerms
+            )
+        }
+    }
 
