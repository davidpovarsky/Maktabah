-    private func openSearch() {
-        guard !searchIsExpanded else { return }
-        let entered = quickAddress.trimmingCharacters(in: .whitespacesAndNewlines)
-        initialSearchQuery = entered == browser.currentPage.address ? "" : entered
-        quickAddressFocused = false
-        withAnimation(morphSpring) { searchIsExpanded = true }
-    }
-
-    private func closeSearch() {
-        guard searchIsExpanded else { return }
-        withAnimation(morphSpring) { searchIsExpanded = false }
-        quickAddress = browser.currentPage.address
-    }
