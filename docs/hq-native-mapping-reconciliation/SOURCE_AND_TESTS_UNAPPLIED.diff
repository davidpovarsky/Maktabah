+
+        var manager: iOSNavigationManager? = .init(installed: true)
+        manager!.openTabs = [a, b]; manager!.activeTabId = idA
+        var adapter: StudyWorkspaceNavigationAdapter? = .init(sceneID: "native", store: store)
